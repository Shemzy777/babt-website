# Forvis Mazars Nigeria — Environment Variables
# Copy this file to .env and fill in the values

# App
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME="Forvis Mazars Nigeria"

# CMS (Contentful — replace with your actual CMS)
VITE_CONTENTFUL_SPACE_ID=your_space_id
VITE_CONTENTFUL_ACCESS_TOKEN=your_access_token
VITE_CONTENTFUL_PREVIEW_TOKEN=your_preview_token

# Google Maps (for office maps)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mailer (for contact form submissions)
VITE_CONTACT_FORM_ENDPOINT=https://your-api.com/contact
